<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LISTA de préstamos: en rojo los retrasados, en gris los devueltos -->
    <record id="prestamo_view_list" model="ir.ui.view">
        <field name="name">biblioteca.prestamo.list</field>
        <field name="model">biblioteca.prestamo</field>
        <field name="arch" type="xml">
            <list decoration-danger="retrasado"
                  decoration-muted="estado == 'devuelto'">
                <field name="name"/>
                <field name="libro_id"/>
                <field name="socio_id"/>
                <field name="fecha_prestamo"/>
                <field name="fecha_prevista"/>
                <field name="estado"/>
                <field name="retrasado"/>
            </list>
        </field>
    </record>

    <!-- FORMULARIO con barra de estado y botones -->
    <record id="prestamo_view_form" model="ir.ui.view">
        <field name="name">biblioteca.prestamo.form</field>
        <field name="model">biblioteca.prestamo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prestar" type="object" string="Prestar"
                            class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_devolver" type="object" string="Devolver"
                            class="btn-primary" invisible="estado != 'prestado'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="libro_id"
                                   readonly="estado != 'borrador'"/>
                            <field name="socio_id"
                                   readonly="estado != 'borrador'"/>
                        </group>
                        <group>
                            <field name="fecha_prestamo"
                                   readonly="estado != 'borrador'"/>
                            <field name="dias"
                                   readonly="estado != 'borrador'"/>
                            <field name="fecha_prevista"/>
                            <field name="fecha_devolucion"/>
                            <field name="retrasado"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

        <!-- BÚSQUEDA: campos, filtros y agrupaciones -->
    <record id="prestamo_view_search" model="ir.ui.view">
        <field name="name">biblioteca.prestamo.search</field>
        <field name="model">biblioteca.prestamo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="libro_id"/>
                <field name="socio_id"/>
                <filter name="filtro_prestados" string="Prestados"
                        domain="[('estado', '=', 'prestado')]"/>
                <filter name="filtro_devueltos" string="Devueltos"
                        domain="[('estado', '=', 'devuelto')]"/>
                <separator/>
                <filter name="agrupar_socio" string="Socio"
                        context="{'group_by': 'socio_id'}"/>
                <filter name="agrupar_estado" string="Estado"
                        context="{'group_by': 'estado'}"/>
            </search>
        </field>
    </record>

        <record id="prestamo_action" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">biblioteca.prestamo</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filtro_prestados': 1}</field>
    </record>

    <menuitem id="menu_prestamos" name="Préstamos"
              parent="menu_biblioteca" action="prestamo_action" sequence="20"/>
</odoo>