<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="libro_view_list" model="ir.ui.view">
        <field name="name">biblioteca.libro.list</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="autor"/>
                <field name="isbn"/>
                <field name="paginas"/>
                <field name="disponible"/>
                <field name="genero"/>
            </list>
        </field>
    </record>

    <record id="libro_view_form" model="ir.ui.view">
        <field name="name">biblioteca.libro.form</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="autor"/>
                        <field name="isbn"/>
                        <field name="fecha_publicacion"/>
                        <field name="paginas"/>
                        <field name="disponible"/>
                        <field name="genero"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="libro_action" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">biblioteca.libro</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_biblioteca" name="Biblioteca"/>
    <menuitem id="menu_libros" name="Libros"
              parent="menu_biblioteca" action="libro_action"/>

</odoo>